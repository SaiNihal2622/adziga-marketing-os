// BILLING (spec ??38)
// ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????

model BillingAccount {
  id              String   @id @default(cuid())
  orgId           String   @unique
  plan            String   @default("FREE")
  monthlyFee      Float    @default(0)
  usageBasedFee   Float    @default(0)
  automationFee   Float    @default(0)
  currency        String   @default("INR")
