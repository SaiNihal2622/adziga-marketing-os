# Adziga Marketing OS — production environment template
# Copy to `.env.production` (or your hosting provider's env vars) and fill in real values.

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite (dev only):  DATABASE_URL="file:./dev.db"
# Postgres (prod):    DATABASE_URL="postgresql://user:pass@host:5432/adziga?schema=public"
DATABASE_URL="file:./dev.db"

# ─── App ───────────────────────────────────────────────────────────────────
APP_URL="https://app.adziga.in"
NEXTAUTH_URL="https://app.adziga.in"
NEXTAUTH_SECRET="GENERATE: openssl rand -base64 32"
AUTH_SECRET="GENERATE: openssl rand -base64 32"

# ─── AI Provider (optional — stub mode if blank) ───────────────────────────
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# ─── Meta (Facebook / Instagram / WhatsApp) ────────────────────────────────
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="GENERATE: openssl rand -hex 16"

# ─── Google Ads ────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""

# ─── WhatsApp Business ─────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─── Razorpay (billing, Indian market) ─────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_PRO="plan_..."
RAZORPAY_PLAN_ZIGA_PLUS="plan_..."

# ─── Email (transactional) ─────────────────────────────────────────────────
# Set EMAIL_PROVIDER to "smtp" or "resend". Leave as "stub" to disable.
EMAIL_PROVIDER="resend"
EMAIL_FROM="Adziga <noreply@adziga.in>"

# Resend (recommended)
RESEND_API_KEY="re_..."

# OR SMTP (fallback)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── Auth ──────────────────────────────────────────────────────────────────
MFA_ENCRYPTION_KEY="GENERATE: openssl rand -base64 32"

# OAuth — Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Feature flags ─────────────────────────────────────────────────────────
ENABLE_AI_ASSISTANT="true"
ENABLE_AUDIT_LOG="true"
ENABLE_INTEGRATIONS="true"
ENABLE_SIGNUP="true"

# ─── Observability (optional) ──────────────────────────────────────────────
SENTRY_DSN=""
LOG_LEVEL="info"
