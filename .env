# Adziga environment — committed defaults for local dev
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="adziga-dev-secret-please-change-in-prod-aaaaaaaaa"
AUTH_SECRET="adziga-dev-secret-please-change-in-prod-aaaaaaaaa"

# Optional AI provider — defaults to stub when not set
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Integrations (placeholders — production should set via env)
META_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
WHATSAPP_API_TOKEN=""

# Feature flags
ENABLE_AI_ASSISTANT="true"
ENABLE_AUDIT_LOG="true"
ENABLE_INTEGRATIONS="true"